# Payment river functions image (adr/records/ADR-0025). Built by Cloud Build from `pulumi up`.
# One image for every function; each Cloud Run service chooses its function with PAY_FUNCTION.
# Install stage: exactly the lockfile (integrity-checked, no install scripts), and only what the
# functions workspace needs — no Next.js, no React, no development tools.
FROM node:22-bookworm-slim AS deps
WORKDIR /repo
COPY package.json package-lock.json .npmrc ./
COPY packages ./packages
COPY apps/web/package.json ./apps/web/package.json
COPY apps/pay-functions ./apps/pay-functions
COPY infra/package.json ./infra/package.json
RUN npm ci --ignore-scripts --no-audit --no-fund --omit=dev --workspace @river/pay-functions

# Runtime stage: distroless Node 22, non-root. The packages run as TypeScript sources (ADR-0015):
# Node strips the types, so there is no build step and nothing here that is not in the repository.
FROM gcr.io/distroless/nodejs22-debian12:nonroot
WORKDIR /repo
ENV NODE_ENV=production PORT=8080
COPY --from=deps /repo/package.json ./package.json
COPY --from=deps /repo/node_modules ./node_modules
COPY --from=deps /repo/packages ./packages
COPY --from=deps /repo/apps/pay-functions ./apps/pay-functions
USER nonroot
EXPOSE 8080
CMD ["--experimental-strip-types", "--no-warnings=ExperimentalWarning", "apps/pay-functions/server.ts"]
